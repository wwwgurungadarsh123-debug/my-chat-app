
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FriendLink</title>
<style>
* {
  box-sizing: border-box;
}
body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #eef4ff;
  color: #172b4d;
}
header {
  background: #1769d2;
  color: white;
  padding: 22px;
  text-align: center;
}
header h1 {
  margin: 0;
  font-size: 28px;
}
header p {
  margin: 6px 0 0;
}
.container {
  max-width: 500px;
  margin: auto;
  padding: 18px;
}
.search {
  width: 100%;
  padding: 14px;
  border: 1px solid #d5e2f5;
  border-radius: 12px;
  font-size: 16px;
  margin-bottom: 18px;
}
h2 {
  color: #1769d2;
}
.friend {
  display: flex;
  align-items: center;
  background: white;
  padding: 14px;
  border-radius: 14px;
  margin-bottom: 10px;
  gap: 12px;
}
.avatar {
  background: #d9eaff;
  color: #1769d2;
  border-radius: 50%;
  width: 48px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
  font-size: 18px;
}
.info {
  flex: 1;
}
.info h3 {
  margin: 0 0 5px;
}
.info p {
  margin: 0;
  color: #718096;
  font-size: 13px;
}
.chat {
  background: white;
  border-radius: 14px;
  padding: 16px;
  margin-top: 20px;
}
#messages {
  min-height: 100px;
  max-height: 250px;
  overflow-y: auto;
}
.message {
  background: #e3efff;
  padding: 11px;
  border-radius: 12px;
  margin: 8px 0;
  overflow-wrap: anywhere;
}
.send {
  display: flex;
  gap: 8px;
  margin-top: 12px;
}
.send input {
  flex: 1;
  min-width: 0;
  padding: 12px;
  border: 1px solid #ccd9ed;
  border-radius: 10px;
  font-size: 15px;
}
button {
  border: 0;
  background: #1769d2;
  color: white;
  padding: 12px 16px;
  border-radius: 10px;
  font-weight: bold;
}
footer {
  text-align: center;
  color: #718096;
  padding: 25px;
  font-size: 13px;
}
</style>
</head>
<body>

<header>
  <h1>💬 FriendLink</h1>
  <p>Connect • Chat • Call</p>
</header>

<div class="container">
  <input class="search" id="search"
    placeholder="🔍 Search friends..."
    oninput="searchFriends()">

  <h2>My Friends</h2>

  <div id="friends">
    <div class="friend">
      <div class="avatar">A</div>
      <div class="info">
        <h3>Alex</h3>
        <p>Hello! How are you?</p>
      </div>
      <span>🟢</span>
    </div>

    <div class="friend">
      <div class="avatar">S</div>
      <div class="info">
        <h3>Sarah</h3>
        <p>Nice to meet you!</p>
      </div>
      <span>🟢</span>
    </div>

    <div class="friend">
      <div class="avatar">J</div>
      <div class="info">
        <h3>John</h3>
        <p>See you soon!</p>
      </div>
      <span>⚪</span>
    </div>
  </div>

  <div class="chat">
    <h2>My Chat 💙</h2>
    <div id="messages">
      <div class="message">
        Welcome to FriendLink! 👋
      </div>
    </div>

    <div class="send">
      <input id="messageInput"
        placeholder="Write a message..."
        onkeydown="if(event.key==='Enter') sendMessage()">
      <button onclick="sendMessage()">Send</button>
    </div>
  </div>
</div>

<footer>
  FriendLink © 2026
  <br>Made with ❤️
</footer>

<script>
function sendMessage() {
  const input = document.getElementById("messageInput");
  const text = input.value.trim();

  if (!text) return;

  const message = document.createElement("div");
  message.className = "message";
  message.textContent = text;

  document.getElementById("messages").appendChild(message);
  input.value = "";
  message.scrollIntoView({block: "nearest"});
}

function searchFriends() {
  const query = document.getElementById("search")
    .value.toLowerCase();

  document.querySelectorAll(".friend").forEach(friend => {
    friend.style.display =
      friend.textContent.toLowerCase().includes(query)
      ? "flex" : "none";
  });
}
</script>

</body>
</html>
